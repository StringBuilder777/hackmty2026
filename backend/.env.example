CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,https://hackmty2026-nu.vercel.app
BRAVE_SEARCH_API_KEY=
# Optional: AI explanation of bounded, verified signals. Never expose this in the frontend.
# El agente interpreta evidencia ya extraída; nunca realiza scraping ni decide hechos.
AI_PROVIDER=bedrock
AWS_REGION=us-east-1
# Elegir un modelo Bedrock habilitado en la región, por ejemplo Claude Sonnet 4.5.
BEDROCK_MODEL_ID=
# Alternativa heredada, solo si AI_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Maximum decompressed HTML per page. Clamped by the backend to 1-16 MiB.
MAX_HTML_BYTES=8388608
ROUTE_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
ORS_API_KEY=
# Absolute path inside the container, e.g. /app/data/branches.json
BRANCH_CATALOG_PATH=
